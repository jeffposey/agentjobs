# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
/src/agentjobs/frontend_dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# Testing
.pytest_cache/
.coverage
# pytest-xdist writes one .coverage.<host>.<pid>.<rand> fragment per worker, so a
# single gate run leaves hundreds of untracked files behind -- enough to make
# `git status` unreadable and to trip dispatch's clean-tree check.
.coverage.*
htmlcov/
.tox/
frontend/playwright-report/
frontend/test-results/
frontend/blob-report/

# Schema docs tooling
# mermaid-cli, for rendering the ER diagrams (see package.json)
node_modules/
# mkdocs build output; the source of truth is docs/ + schema/
site/

# IDE
.vscode/*
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# AgentJobs runtime
.agentjobs/

# Build artifacts and evidence produced by a run, never sources.
out/

# Machine-local evidence of managed writes. Never committed: they would make every
# write a diff, and a clean clone has none anyway.
.agentjobs/write-receipts/

# Client MCP wiring. The working entry names an interpreter path that is specific to
# one machine's virtualenv, so there is no version of this file that is correct for
# two people at once. docs/mcp-clients.md carries both invocations; write your own.
.mcp.json
