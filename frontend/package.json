{
  "name": "agentjobs-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-service-worker.mjs",
    "generate:icons": "poetry run python scripts/generate_icons.py",
    "check:icons": "poetry run python scripts/generate_icons.py --check",
    "generate:api-schema": "poetry run python ../scripts/export_openapi.py openapi.json",
    "generate:api-client": "openapi-ts",
    "generate:api": "npm run generate:api-schema && npm run generate:api-client",
    "check:api-schema": "poetry run python ../scripts/export_openapi.py openapi.json --check",
    "check:api-client": "openapi-ts && node scripts/assert-generated-clean.mjs",
    "check:api": "npm run check:api-schema && npm run check:api-client",
    "lint": "oxlint --ignore-pattern src/api/generated/** .",
    "test": "vitest run",
    "install:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "check": "npm run check:api && npm run check:icons && npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
