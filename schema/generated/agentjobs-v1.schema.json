            ]
        },
        "id": {
            "description": "Unique task identifier (e.g. task-001).",
            "type": "string"
        },
        "issues": {
            "description": "Issues encountered while executing the task. Empty in every file in the corpus; deleted in v2 (D1).",
            "items": {
                "$ref": "#/$defs/Issue"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "phases": {
            "description": "Sub-units inside one task. Not claimable, no prompts, no comments. Overlaps with real sub-tasks; deleted in v2 (D1).",
            "items": {
                "$ref": "#/$defs/Phase"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "priority": {
            "$ref": "#/$defs/Priority",
            "description": "Relative priority weighting."
        },
        "prompts": {
            "anyOf": [
                {
                    "$ref": "#/$defs/Prompts"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Prompt collection used by collaborating agents. Deleted in v2 (D1) -- the starter almost always restates the description."
        },
        "status": {
            "$ref": "#/$defs/TaskStatus",
            "description": "Current workflow status."
        },
        "status_updates": {
            "description": "Chronological status updates. Append-only, timestamped, authored -- the same shape as comments, with an implied but unenforced role split.",
            "items": {
