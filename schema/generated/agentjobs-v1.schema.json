            },
            "type": [
                "array",
                "null"
            ]
        },
        "success_criteria": {
            "description": "Success criteria checklist.",
            "items": {
                "$ref": "#/$defs/SuccessCriterion"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "tags": {
            "description": "Tag metadata for filtering and search. No vocabulary enforced.",
            "items": {
                "type": "string"
