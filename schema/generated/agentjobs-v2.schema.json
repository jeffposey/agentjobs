        }
    ],
    "description": "A unit of work. One YAML file per task, in git -- diffable, reviewable, blame-able, mergeable. Hand-editing remains a first-class interface (D2).",
    "metamodel_version": "1.11.0",
    "properties": {
        "acceptance": {
            "description": "What \"done\" means. Replaces success_criteria.",
            "items": {
                "$ref": "#/$defs/AcceptanceCriterion"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "archived": {
            "description": "Visibility flag, orthogonal to how the task ended. Lets an old completed task and an abandoned draft both be hidden without destroying what they were.",
            "type": [
                "boolean",
                "null"
            ]
        },
        "assignment": {
            "anyOf": [
                {
                    "$ref": "#/$defs/Assignment"
                },
                {
                    "type": "null"
                }
            ],
            "description": "Live ownership plus authoring-time eligibility."
        },
        "ball": {
            "$ref": "#/$defs/Ball",
            "description": "Who acts next. Required while open; absent or null when closed. This is the field that makes limbo unrepresentable."
        },
        "ball_prompt": {
            "description": "The ask, in prose, addressed to whoever holds the ball. Required whenever the ball is set (tenet 3): a handoff without its payload is rejected at the schema level. May default for agent/available, where the spec is the ask.",
            "type": [
                "string",
                "null"
            ]
        },
        "ball_reason": {
            "$ref": "#/$defs/BallReason",
            "description": "Why the ball holder holds it. Must belong to that holder's vocabulary -- see the rules on this class."
        },
        "branches": {
            "description": "Git branches associated with the task.",
            "items": {
                "$ref": "#/$defs/Branch"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "category": {
            "description": "Validated against the project config vocabulary at save time, not enumerated in this schema -- taxonomy is project-local, semantics are not.",
            "type": "string"
        },
        "created": {
            "description": "Creation timestamp.",
            "format": "date-time",
            "type": "string"
        },
        "deliverables": {
            "description": "Artifacts the task is expected to produce.",
            "items": {
                "$ref": "#/$defs/Deliverable"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "dependencies": {
            "description": "Relationships to other tasks. Validated against the store at save.",
            "items": {
                "$ref": "#/$defs/Dependency"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "effort": {
            "description": "Free text; renamed from estimated_effort. It is an estimate, not a contract, so it is deliberately unstructured.",
            "type": [
                "string",
                "null"
            ]
        },
        "id": {
            "description": "Unique task identifier (e.g. task-050-schema-v2-models).",
            "type": "string"
        },
        "lifecycle": {
            "$ref": "#/$defs/Lifecycle",
            "description": "Where the task is in its life."
        },
        "links": {
            "description": "External references. Renamed from external_links; URL now validated.",
            "items": {
                "$ref": "#/$defs/Link"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "log": {
            "description": "One append-only typed log (section 4). Entries are immutable and ordered. Replaces status_updates + comments + prompts.followups.",
            "items": {
                "$ref": "#/$defs/LogEntry"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "outcome": {
            "$ref": "#/$defs/Outcome",
            "description": "How the task ended. Set if and only if lifecycle is closed; absent or null while open."
        },
        "parent": {
            "description": "Task id of an umbrella task. Tasks with open children are never claimable. Absorbs task-045's parent/child design.",
            "type": [
                "string",
                "null"
            ]
        },
        "priority": {
            "$ref": "#/$defs/Priority"
        },
        "queue_position": {
            "description": "Explicit order within the priority band. Unique among open tasks of the same priority in one project. Present if and only if the task is open. Assigned in sparse steps of 100 so an insertion takes a midpoint and rewrites one file rather than a whole band.",
            "minimum": 1,
            "type": [
                "integer",
                "null"
            ]
        },
        "schema": {
            "const": 2,
            "description": "Schema version stamp. A missing `schema` field means v1, which the v2 loader refuses loudly rather than guessing. Breaking changes bump this integer and ship a converter; additive changes do not bump it. NOTE for task-050: as a Pydantic field name, `schema` shadows a deprecated BaseModel attribute and will emit a shadow warning -- needs an alias or a model_config allowance.",
            "type": "integer"
        },
        "spec": {
            "$ref": "#/$defs/Spec",
            "description": "The structured briefing. Replaces v1's single description blob and its duplicated starter prompt."
        },
        "tags": {
            "description": "Also validated against the config vocabulary at save.",
            "items": {
                "type": "string"
            },
            "type": [
                "array",
                "null"
            ]
        },
        "title": {
            "description": "Task title summarising the work.",
            "type": "string"
        },
        "updated": {
            "description": "Last update timestamp.",
            "format": "date-time",
            "type": "string"
        }
    },
    "required": [
        "schema",
        "id",
        "title",
        "created",
        "updated",
        "lifecycle",
        "category",
        "spec"
    ],
    "title": "agentjobs-v2",
    "type": "object",
    "version": "2.0.0"
}

