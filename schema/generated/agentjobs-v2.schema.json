                            ]
                        }
                    ]
                },
                "properties": {
                    "lifecycle": {
                        "anyOf": [
                            {
                                "const": "draft"
                            },
                            {
                                "const": "ready"
                            },
                            {
                                "const": "active"
                            }
                        ]
                    }
                },
                "required": [
                    "lifecycle"
                ]
            },
            "then": {
                "properties": {
                    "ball_prompt": {}
