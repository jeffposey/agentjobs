{
  "about": "Every status chip's word and colour (task-562). The server reads this for the words and categories it sends as display_status and status_category; the React app reads it for the colours. Edit a label or a colour here and both follow. A category's colours apply in every theme: they carry meaning, so a theme does not restyle them.",
  "categories": {
    "ready": {
      "meaning": "Can start.",
      "fill": "#064e3b",
      "border": "#059669",
      "text": "#d1fae5"
    },
    "queued": {
      "meaning": "Will start on its own: a dispatch is waiting for a slot.",
      "fill": "#4a2c17",
      "border": "#8b5a2b",
      "text": "#f1dcc5"
    },
    "working": {
      "meaning": "Running: an agent is on it.",
      "fill": "#1e3a8a",
      "border": "#2563eb",
      "text": "#dbeafe"
    },
    "finishing": {
      "meaning": "Merging: a scripted finish is rebasing, gating and merging it.",
      "fill": "#4c1d95",
      "border": "#7c3aed",
      "text": "#ede9fe"
    },
    "needs_you": {
      "meaning": "Waiting, and will not continue until a person acts.",
      "fill": "#7f1d1d",
      "border": "#dc2626",
      "text": "#fee2e2"
    },
    "not_now": {
      "meaning": "Will not start yet, and not because of you: it clears without a person.",
      "fill": "#831843",
      "border": "#db2777",
      "text": "#fce7f3"
    },
    "draft": {
      "meaning": "Not specified yet, and not with a person.",
      "fill": "#713f12",
      "border": "#ca8a04",
      "text": "#fef9c3"
    },
    "closed": {
      "meaning": "Finished: the work was done.",
      "fill": "#475569",
      "border": "#94a3b8",
      "text": "#f8fafc"
    },
    "closed_unfinished": {
      "meaning": "Ended without the work being done. Hollow where Completed is solid.",
      "fill": "transparent",
      "border": "#64748b",
      "text": "#94a3b8",
      "border_style": "dashed"
    }
  },
  "statuses": {
